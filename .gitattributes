# 大二进制文件走 Git LFS（Large File Storage）。
#
# ⚠️ 首次使用前请在仓库里执行一次：
#       git lfs install
#   本机已安装 git-lfs 3.7.1，直接执行上面的命令即可。
#
# 若不执行 `git lfs install` 就直接提交，这些文件会以原始字节进入 Git 对象库，
# 其中 161 MB 的地图会被 GitHub 以"单文件超过 100 MB"为由拒绝整次 push。

*.glb   filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.mp3   filter=lfs diff=lfs merge=lfs -text
*.wav   filter=lfs diff=lfs merge=lfs -text
*.zip   filter=lfs diff=lfs merge=lfs -text

# Persistent fixed mesh assets (69 / 81 MB).
UnityProject/Assets/_FlightDemo/Art/World/CentralRepairs/*.asset filter=lfs diff=lfs merge=lfs -text
